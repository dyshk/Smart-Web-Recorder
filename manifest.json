{
  "manifest_version": 3,
  "name": "智能听力录音机",
  "description": "录制当前网页标签页声音，拖动选择听力片段并保存。支持固定窗口置顶、波形可视化。",
  "version": "1.0.0",
  "minimum_chrome_version": "88",
  "permissions": [
    "activeTab",
    "storage",
    "tabCapture",
    "tabs",
    "windows"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "智能听力录音机",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-web-recorder@local.extension",
      "strict_min_version": "112.0"
    }
  }
}
