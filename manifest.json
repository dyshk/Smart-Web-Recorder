{
  "manifest_version": 3,
  "name": "智能网页探测器",
  "short_name": "探测器",
  "description": "Record tab audio & one-click detect/download all media files (audio, video, docs, images). 录制网页声音、一键探测下载所有媒体文件（音频、视频、文档、图片）。",
  "version": "2.0.0",
  "minimum_chrome_version": "88",
  "permissions": [
    "activeTab",
    "storage",
    "tabCapture",
    "tabs",
    "windows",
    "downloads",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "智能网页探测器",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-web-recorder@local.extension",
      "strict_min_version": "112.0"
    }
  }
}
